put edge decision.edge.bootstrap.generation { attrs = { specdot_branch = "future-generation", specdot_id = "decision.edge.bootstrap.generation", specdot_kind = "decision" }, element = "edge", from = "decision.bootstrap.authority", graph_id = "decision.specdot.bootstrap", id = "decision.edge.bootstrap.generation", kind = "decision", location = { column = 36, file = "specs/architecture.dot", line = 13 }, status = "active", summary = "Separates today’s release authority from a future self-hosted build path driven by sealed IR.", title = "Defer code generation", to = "decision.bootstrap.future_build" }
put edge decision.edge.bootstrap.implementation { attrs = { specdot_branch = "current-implementation", specdot_id = "decision.edge.bootstrap.implementation", specdot_kind = "decision" }, element = "edge", from = "decision.bootstrap.authority", graph_id = "decision.specdot.bootstrap", id = "decision.edge.bootstrap.implementation", kind = "decision", location = { column = 32, file = "specs/architecture.dot", line = 10 }, status = "active", summary = "Keeps the current Go implementation and independent tests as the present release authority.", title = "Trust current Go bootstrap", to = "decision.bootstrap.go" }
