put contract graph.gridspec.authority { kind = "algorithm", location = { column = 1, file = "docs/architecture.md", line = 1 }, metadata = { authority = "signed Grid Commit v3 over complete timeline heads", carrier = "Git objects and refs carry CID-addressed Grid closures but do not define semantic identity", compiler = "CAS reload and LLM-assisted translation followed by deterministic validation and tests", disassembler = "accepted state CID plus existing code yields a reviewable transaction proposal", docker_analogy = "transaction programs resemble Dockerfiles, state CIDs resemble image digests, and Git-backed CAS resembles the local content store or registry", equivalence = "bounded conformance evidence, never a general proof of program equivalence", generation_input = "accepted state CID by default or an explicitly selected current vetted proposal state CID", llm_trust = "LLMs propose transformations and never receive signing keys or acceptance authority", materialization = "deterministic replay must produce and verify a complete CAS state CID before any downstream consumer runs", source_language = "GridSpec transaction language v1 over Grid-CBOR state" }, schema = "gridspec.contract/v1", status = "active", summary = "Transactions are replayed into mandatory CAS state CIDs; views, checks, and generators consume those CIDs, while only a signed complete Grid Commit v3 selection changes accepted state." }
put contract graph.gridspec.describe { kind = "algorithm", location = { column = 1, file = "docs/architecture.md", line = 142 }, metadata = { acceptance = "separate signed operator action", audit = "exact request and response stored as a required CAS link", model_output = "strict JSON descriptions only", proposal_base = "the exact loaded accepted state", transaction_authority = "deterministic field-preserving tool code" }, schema = "gridspec.contract/v1", status = "active", summary = "Create reviewable description proposals while deterministic code retains transaction and acceptance authority." }
put contract graph.gridspec.qualification { for = "graph.gridspec.qualification", kind = "algorithm", location = { column = 1, file = "docs/architecture.md", line = 84 }, metadata = { authority = "accepted scenario contracts", conformance = "existing Go is checked against accepted commands without regeneration", evidence = "gridspec.qualification/v1 stored through the derived-artifact CAS envelope", mapping = "generated output or an implementation sidecar maps artifact names to Go packages", missing_oracle = "publish an audited unsigned scenario proposal and emit no code", shared_runner = "generated and existing Go execute through one bounded accepted-scenario runner", update = "qualify a reconstructed temporary module before applying hash-rechecked owned files" }, schema = "gridspec.contract/v1", status = "active", summary = "Accepted command contracts, not generated tests, decide whether compiler output qualifies." }
put contract graph.specdot.checker { for = "graph.specdot.checker", kind = "algorithm", location = { column = 1, file = "specs/checker.md", line = 16 }, schema = "specdot.contract/v1", status = "active", summary = "Bounded safety and liveness analysis over canonical machine configurations." }
put contract graph.specdot.conform { for = "graph.specdot.conform", kind = "algorithm", location = { column = 1, file = "specs/conform.md", line = 28 }, metadata = { baseline_schema = "gridspec.conformance-baseline/v1", command_authority = "accepted executable scenario contracts", duplicate_oracle = "a sidecar command for an accepted executable scenario is rejected", implementation_schema = "gridspec.implementation/v1", report_schema = "gridspec.conformance/v1", shared_runner = "generated and existing Go use the same accepted-scenario runner", sidecar_role = "artifact and symbol mappings plus supplemental test and trace evidence", trace_schema = "gridspec.trace/v1" }, schema = "specdot.contract/v1", status = "active", summary = "Deterministically compare a vetted specification with existing Go code." }
put contract graph.specdot.data { for = "graph.specdot.data", kind = "data", location = { column = 1, file = "specs/data.md", line = 10 }, schema = "specdot.contract/v1", status = "active", summary = "Nominal inputs, intermediate representations, diagnostics, and output resources." }
