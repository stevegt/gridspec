put contract graph.specdot.interfaces { for = "graph.specdot.interfaces", kind = "promise", location = { column = 1, file = "specs/interfaces.md", line = 11 }, schema = "specdot.contract/v1", status = "active", summary = "Operator-facing request and result promises for one vet invocation." }
