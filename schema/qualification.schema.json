{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promisegrid.github.io/gridspec/schema/qualification.schema.json",
  "title": "GridSpec generated-code qualification evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "output_digest", "artifacts", "go_test", "scenarios"],
  "properties": {
    "schema": {"const": "gridspec.qualification/v1"},
    "source": {"$ref": "#/$defs/source"},
    "output_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "go_test": {"$ref": "#/$defs/process"},
    "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "accepted_commit", "event", "state"],
      "properties": {
        "kind": {"enum": ["accepted", "proposal"]},
        "accepted_commit": {"type": "string", "minLength": 1},
        "event": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["name", "package"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "package": {"type": "string", "pattern": "^(\\.|\\./[^/:\\\\]+(?:/[^/:\\\\]+)*)$"}
      }
    },
    "process": {
      "type": "object", "additionalProperties": false, "required": ["exit_code", "stdout", "stderr"],
      "properties": {
        "exit_code": {"type": "integer"},
        "stdout": {"type": "string", "maxLength": 1048576},
        "stderr": {"type": "string", "maxLength": 1048576}
      }
    },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "exists"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "exists": {"type": "boolean"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "exit_code", "stdout", "stderr", "files"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "stdout": {"type": "string", "maxLength": 1048576},
        "stderr": {"type": "string", "maxLength": 1048576},
        "files": {"type": "array", "items": {"$ref": "#/$defs/file"}}
      }
    },
    "repeat": {
      "type": "object", "additionalProperties": false, "required": ["run", "steps"],
      "properties": {
        "run": {"type": "integer", "minimum": 1, "maximum": 10},
        "steps": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/step"}}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false, "required": ["id", "covers", "repeats"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "covers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "repeats": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/repeat"}}
      }
    }
  }
}
