{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promisegrid.github.io/gridspec/schema/conformance.schema.json",
  "title": "GridSpec conformance report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "module", "implementation", "spec_digest", "evidence", "coverage", "diagnostics"],
  "properties": {
    "schema": {"const": "gridspec.conformance/v1"},
    "module": {"type": "string"}, "implementation": {"type": "string"}, "spec_digest": {"type": "string"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["static", "command", "go_test", "trace"],
      "properties": {
        "static": {"$ref": "#/$defs/coverage"}, "command": {"$ref": "#/$defs/coverage"},
        "go_test": {"$ref": "#/$defs/coverage"}, "trace": {"$ref": "#/$defs/coverage"}
      }
    },
    "exclusions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["spec_id", "reason"], "properties": {"spec_id": {"type": "string"}, "reason": {"type": "string"}}}},
    "accepted_scenario_runs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}},
    "diagnostics": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["static", "command", "go_test", "trace"], "properties": {"static": {"$ref": "#/$defs/ids"}, "command": {"$ref": "#/$defs/ids"}, "go_test": {"$ref": "#/$defs/ids"}, "trace": {"$ref": "#/$defs/ids"}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["eligible", "covered", "percent", "floor"], "properties": {"eligible": {"type": "integer"}, "covered": {"type": "integer"}, "percent": {"type": "number"}, "floor": {"type": "number"}}},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "exists"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "exists": {"type": "boolean"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false, "required": ["id", "exit_code", "stdout", "stderr", "files"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "exit_code": {"type": "integer"},
        "stdout": {"type": "string", "maxLength": 1048576}, "stderr": {"type": "string", "maxLength": 1048576},
        "files": {"type": "array", "items": {"$ref": "#/$defs/file"}}
      }
    },
    "repeat": {
      "type": "object", "additionalProperties": false, "required": ["run", "steps"],
      "properties": {
        "run": {"type": "integer", "minimum": 1, "maximum": 10},
        "steps": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/step"}}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false, "required": ["id", "covers", "repeats"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "covers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "repeats": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/repeat"}}
      }
    }
  }
}
