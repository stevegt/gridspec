{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promisegrid.github.io/gridspec/schema/trace.schema.json",
  "title": "GridSpec semantic trace event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scenario_id", "spec_id", "sequence"],
  "properties": {
    "schema": {"const": "gridspec.trace/v1"},
    "scenario_id": {"type": "string", "minLength": 1},
    "spec_id": {"type": "string", "minLength": 1},
    "phase": {"type": "string"},
    "outcome": {"type": "string"},
    "sequence": {"type": "integer", "minimum": 1},
    "fields": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
