digraph gridspec_view {
  graph [label="github.com/promisegrid/gridspec (generated view)", labelloc=t];
  node [shape=plaintext];
  "id:gridspec.describe.accepted" [label="Load accepted state [gridspec.describe.accepted]",shape=circle,tooltip="gridspec.describe.accepted: Load and verify the accepted CAS state that supplies both context and the proposal base."];
  "id:gridspec.describe.audit" [label="Build model audit [gridspec.describe.audit]",shape=box,tooltip="gridspec.describe.audit: Encode the exact request, response, provider metadata, and selected source identity for CAS storage."];
  "id:gridspec.describe.complete" [label="Descriptions complete? [gridspec.describe.complete]",shape=diamond,tooltip="gridspec.describe.complete: Choose between a no-op and one bounded model request from the deterministic target set."];
  "id:gridspec.describe.failure" [label="Reject invalid generation [gridspec.describe.failure]",shape=doublecircle,tooltip="gridspec.describe.failure: Leave accepted state unchanged after provider, validation, audit, replay, or proposal failure."];
  "id:gridspec.describe.noop" [label="Return without a proposal [gridspec.describe.noop]",shape=doublecircle,tooltip="gridspec.describe.noop: Exit successfully without a provider call when every selected entity is already described."];
  "id:gridspec.describe.proposal" [label="Publish unsigned proposal [gridspec.describe.proposal]",shape=doublecircle,tooltip="gridspec.describe.proposal: Materialize a proposal pinned to the loaded base state and linked to the CAS audit object."];
  "id:gridspec.describe.request" [label="Request model descriptions [gridspec.describe.request]",shape=box,tooltip="gridspec.describe.request: Send the complete canonical text state and exact target list in one model request."];
  "id:gridspec.describe.select" [label="Select missing descriptions [gridspec.describe.select]",shape=box,tooltip="gridspec.describe.select: Select active graph, node, and edge entities that lack a title or summary."];
  "id:gridspec.describe.transaction" [label="Build preserving transaction [gridspec.describe.transaction]",shape=box,tooltip="gridspec.describe.transaction: Construct assertions and full field-preserving puts without accepting model-authored transaction text."];
  "id:gridspec.describe.validate" [label="Validate model response [gridspec.describe.validate]",shape=diamond,tooltip="gridspec.describe.validate: Require strict JSON, exact target coverage, and descriptions within the accepted length limits."];
  "id:gridspec.describe.accepted" -> "id:gridspec.describe.select" [label="Read canonical entities [gridspec.describe.flow.accepted.select]",tooltip="gridspec.describe.flow.accepted.select: Pass the verified accepted state to deterministic target selection."];
  "id:gridspec.describe.audit" -> "id:gridspec.describe.failure" [label="Audit encoding fails [gridspec.describe.flow.audit.failure]",tooltip="gridspec.describe.flow.audit.failure: Terminate without a proposal when deterministic audit encoding or CAS storage fails."];
  "id:gridspec.describe.audit" -> "id:gridspec.describe.transaction" [label="Link audit evidence [gridspec.describe.flow.audit.transaction]",tooltip="gridspec.describe.flow.audit.transaction: Carry the complete model exchange as a required CAS link on the proposal."];
  "id:gridspec.describe.complete" -> "id:gridspec.describe.noop" [label="No descriptions missing [gridspec.describe.flow.complete.noop]",tooltip="gridspec.describe.flow.complete.noop: Take the no-op path without configuring or calling a model provider."];
  "id:gridspec.describe.complete" -> "id:gridspec.describe.request" [label="Descriptions are missing [gridspec.describe.flow.complete.request]",tooltip="gridspec.describe.flow.complete.request: Take the generation path when at least one selected entity lacks a title or summary."];
  "id:gridspec.describe.request" -> "id:gridspec.describe.failure" [label="Provider request fails [gridspec.describe.flow.request.failure]",tooltip="gridspec.describe.flow.request.failure: Terminate without a proposal when provider configuration or execution fails."];
  "id:gridspec.describe.request" -> "id:gridspec.describe.validate" [label="Receive model response [gridspec.describe.flow.request.validate]",tooltip="gridspec.describe.flow.request.validate: Pass the single model response to strict structural and semantic validation."];
  "id:gridspec.describe.select" -> "id:gridspec.describe.complete" [label="Check selected targets [gridspec.describe.flow.select.complete]",tooltip="gridspec.describe.flow.select.complete: Classify the selected target set as empty or requiring generation."];
  "id:gridspec.describe.transaction" -> "id:gridspec.describe.failure" [label="Proposal construction fails [gridspec.describe.flow.transaction.failure]",tooltip="gridspec.describe.flow.transaction.failure: Terminate without changing accepted state when replay, validation, or publication fails."];
  "id:gridspec.describe.transaction" -> "id:gridspec.describe.proposal" [label="Materialize proposal [gridspec.describe.flow.transaction.proposal]",tooltip="gridspec.describe.flow.transaction.proposal: Replay the preserving transaction from the pinned base and publish its unsigned proposal event."];
  "id:gridspec.describe.validate" -> "id:gridspec.describe.audit" [label="Response is valid [gridspec.describe.flow.validate.audit]",tooltip="gridspec.describe.flow.validate.audit: Continue only after every requested entity has one valid description and no extra fields."];
  "id:gridspec.describe.validate" -> "id:gridspec.describe.failure" [label="Response is invalid [gridspec.describe.flow.validate.failure]",tooltip="gridspec.describe.flow.validate.failure: Reject incomplete, duplicate, malformed, unexpected, or overlong model output."];
}
