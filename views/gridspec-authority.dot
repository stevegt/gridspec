digraph gridspec_view {
  graph [label="github.com/promisegrid/gridspec (generated view)", labelloc=t];
  node [shape=plaintext];
  "id:gridspec.acceptance.decision" [label="Acceptance decision [gridspec.acceptance.decision]",shape=diamond,tooltip="gridspec.acceptance.decision: Separates proposal review from the act that changes accepted state."];
  "id:gridspec.derived.outputs" [label="Derived outputs [gridspec.derived.outputs]",shape=doublecircle,tooltip="gridspec.derived.outputs: Views, checks, docs, and generators derived from a selected materialized state."];
  "id:gridspec.materialized.state" [label="Materialized CAS state [gridspec.materialized.state]",shape=box,tooltip="gridspec.materialized.state: The complete verified state closure produced by deterministic replay into content-addressed storage."];
  "id:gridspec.proposal" [label="Vetted proposal [gridspec.proposal]",shape=box,tooltip="gridspec.proposal: A reviewable proposed state that has been materialized and validated but not accepted."];
  "id:gridspec.rejected" [label="Rejected proposal [gridspec.rejected]",shape=doublecircle,tooltip="gridspec.rejected: A terminal outcome where review does not change accepted state."];
  "id:gridspec.replay" [label="Deterministic replay [gridspec.replay]",shape=box,tooltip="gridspec.replay: The transaction execution step that computes the next state from a base state."];
  "id:gridspec.signed.commit" [label="Signed accepted selection [gridspec.signed.commit]",shape=box,tooltip="gridspec.signed.commit: The cryptographically signed act that selects authoritative timeline heads."];
  "id:gridspec.transaction" [label="Transaction program [gridspec.transaction]",shape=circle,tooltip="gridspec.transaction: The input change description replayed against a base state."];
  "id:gridspec.vet" [label="State validation [gridspec.vet]",shape=box,tooltip="gridspec.vet: Deterministic validation applied to a fully materialized state before proposal or use."];
  "id:gridspec.signed.commit" -> "id:gridspec.derived.outputs" [label="Accepted state drives outputs [gridspec.flow.accepted.outputs]",tooltip="gridspec.flow.accepted.outputs: Uses the signed accepted state as the default input for views, checks, and generation."];
  "id:gridspec.acceptance.decision" -> "id:gridspec.signed.commit" [label="Accept proposal [gridspec.flow.decision.accept]",tooltip="gridspec.flow.decision.accept: Turns an acceptance decision into a signed commit selecting authoritative timeline heads."];
  "id:gridspec.acceptance.decision" -> "id:gridspec.rejected" [label="Reject proposal [gridspec.flow.decision.reject]",tooltip="gridspec.flow.decision.reject: Ends review without changing accepted state when a proposal is rejected."];
  "id:gridspec.materialized.state" -> "id:gridspec.vet" [label="Vet materialized state [gridspec.flow.materialize.vet]",tooltip="gridspec.flow.materialize.vet: Runs validation only after deterministic replay materializes the full CAS state."];
  "id:gridspec.proposal" -> "id:gridspec.acceptance.decision" [label="Review vetted proposal [gridspec.flow.proposal.decision]",tooltip="gridspec.flow.proposal.decision: Sends a vetted proposal to the separate acceptance decision step."];
  "id:gridspec.proposal" -> "id:gridspec.derived.outputs" [label="Preview proposal outputs [gridspec.flow.proposal.preview]",tooltip="gridspec.flow.proposal.preview: Allows derived views from a current vetted proposal without granting acceptance."];
  "id:gridspec.replay" -> "id:gridspec.materialized.state" [label="Materialize replay result [gridspec.flow.replay.materialize]",tooltip="gridspec.flow.replay.materialize: Converts replayed transactions into a verified content-addressed state closure."];
  "id:gridspec.transaction" -> "id:gridspec.replay" [label="Replay transaction [gridspec.flow.transaction.replay]",tooltip="gridspec.flow.transaction.replay: Executes transaction text against a base state to compute the next state."];
  "id:gridspec.vet" -> "id:gridspec.proposal" [label="Propose vetted state [gridspec.flow.vet.proposal]",tooltip="gridspec.flow.vet.proposal: Promotes a validated materialized state into a reviewable proposal."];
}
